{
  "name": "wakatime-node",
  "version": "0.2.0",
  "description": "Typed TypeScript SDK for the WakaTime REST API",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint --cache .",
    "format": "prettier -l --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "vitest run --config vitest.functional.config.ts"
  },
  "keywords": [
    "wakatime",
    "sdk",
    "api",
    "typescript",
    "coding-stats"
  ],
  "author": "Rushi Vishavadia <rushi@hey.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushi/wakatime-node.git"
  },
  "homepage": "https://github.com/rushi/wakatime-node#readme",
  "bugs": {
    "url": "https://github.com/rushi/wakatime-node/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-use-extend-native": "^0.7.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "prettier": {
    "semi": true,
    "printWidth": 120,
    "trailingComma": "all",
    "singleQuote": false,
    "bracketSpacing": true,
    "useTabs": false,
    "arrowParens": "always",
    "bracketSameLine": false,
    "tabWidth": 4,
    "overrides": [
      {
        "files": [
          "*.json",
          "*.yaml",
          "*.yml"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  }
}
